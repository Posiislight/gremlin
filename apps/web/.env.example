# Engine base URL (server-side proxy target). Unreachable or unset => mock data.
NEXT_PUBLIC_GREMLIN_API=http://localhost:3000
# Project API key. Server-side only; never exposed to the browser (all calls go through /api/gremlin).
GREMLIN_API_KEY=
# Force mock mode (no engine needed)
NEXT_PUBLIC_MOCK=1
