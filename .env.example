# Copy to .env. Defaults match docker-compose.yml.
# If host port 5432 is taken, set GREMLIN_PG_PORT (e.g. 5434) and use the same port in DATABASE_URL.
GREMLIN_PG_PORT=5432
DATABASE_URL=postgres://gremlin:gremlin@localhost:5432/gremlin
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gremlin
S3_ACCESS_KEY=gremlin
S3_SECRET_KEY=gremlin-secret
OPENROUTER_API_KEY=
GREMLIN_SECRET_KEY=change-me-local-dev-secret
# One per agent role, e.g. GREMLIN_MODEL_<ROLE>
GREMLIN_MODEL_PLANNER=
GREMLIN_MODEL_EXECUTOR=
GREMLIN_MODEL_JUDGE=
