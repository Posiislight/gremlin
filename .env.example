# Copy to .env. Defaults match docker-compose.yml.
# If host port 5432 is taken, set GREMLIN_PG_PORT and use the same port in DATABASE_URL.
# NOTE: the dev machine this was built on uses 5434 (native postgres owns 5432).
GREMLIN_PG_PORT=5432
DATABASE_URL=postgres://gremlin:gremlin@localhost:5432/gremlin
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gremlin
S3_ACCESS_KEY=gremlin
S3_SECRET_KEY=gremlin-secret
OPENROUTER_API_KEY=
GREMLIN_SECRET_KEY=change-me-local-dev-secret
GREMLIN_MODEL_NAVIGATOR=z-ai/glm-5.3-flash
GREMLIN_MODEL_JUDGE=z-ai/glm-5.3-flash
GREMLIN_MODEL_MAPPER=z-ai/glm-5.3-flash
GREMLIN_MODEL_HEALER=z-ai/glm-5.3-flash
GREMLIN_MODEL_REFLECT=z-ai/glm-5.3-flash
GREMLIN_MODEL_SCENARIO=z-ai/glm-5.3-flash
GREMLIN_AUTOFIX_REPRO_CMD=
